{
  "$schema": "./_schema.json",
  "id": "cloudflare",
  "label": "Cloudflare Workers AI",
  "docs": "https://developers.cloudflare.com/workers-ai/models/",
  "console": "https://dash.cloudflare.com/profile/api-tokens",
  "enabled": true,
  "priority": 20,
  "adapter": "openai",
  "baseUrl": "https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1",
  "auth": {
    "type": "bearer",
    "envKeys": ["CLOUDFLARE_API_TOKEN"]
  },
  "limits": {
    "creditsPerDay": 10000,
    "creditsPerRequest": 15
  },
  "limitsSource": "docs",
  "verifiedOn": "2026-08-16",
  "modelsEndpoint": null,
  "modelsPath": "data[].id",
  "dropParams": [],
  "headers": {},
  "notes": "Free tier is 10,000 neurons/day (confirmed on the pricing page), metered per token rather than per request. Per-model neuron rates come straight from Cloudflare's published table; note output tokens cost roughly 7-10x input, which is why rates are per-model rather than one flat number. limits.creditsPerRequest is only a fallback for models without published rates. Model ids contain '/', which is why provider/model pins split on the FIRST slash only. The OpenAI-compatible surface exposes /chat/completions and /embeddings but not /models, hence modelsEndpoint: null.",
  "models": [
    {
