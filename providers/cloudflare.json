      "label": "Llama 3.1 8B Instruct",
      "alias": ["cheap"],
      "context": 8192,
      "caps": ["chat", "code"],
      "priority": 30,
      "credits": { "perMTokIn": 2457, "perMTokOut": 18252 }
    },
    {
      "id": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
      "label": "Llama 3.3 70B Instruct (fp8 fast)",
      "alias": ["big"],
      "context": 24000,
      "caps": ["chat", "tools", "code"],
      "priority": 20,
      "credits": { "perMTokIn": 26668, "perMTokOut": 204805 }
    },
    {
