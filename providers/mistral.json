{
  "$schema": "./_schema.json",
  "id": "mistral",
  "label": "Mistral AI",
  "docs": "https://docs.mistral.ai/getting-started/models/models_overview/",
  "console": "https://console.mistral.ai/api-keys",
  "enabled": true,
  "priority": 10,
  "adapter": "openai",
  "baseUrl": "https://api.mistral.ai/v1",
  "auth": {
    "type": "bearer",
    "envKeys": [
      "MISTRAL_API_KEY",
      "MISTRAL_API_KEY_2"
    ]
  },
  "limits": {
    "tpmo": 1000000000,
    "tpm": 25000
  },
  "limitsSource": "observed",
  "verifiedOn": "2026-08-17",
  "modelsEndpoint": "/models",
  "modelsPath": "data[].id",
  "dropParams": [],
  "headers": {},
  "notes": "Free 'Experiment' plan: phone verification required, no credit card. Model ids are -latest aliases confirmed against a live GET /models on 2026-08-17 — deliberately NOT the dated ids from the docs overview page, several of which return 'Invalid model' on the API. Prefer -latest: it survives Mistral retiring a dated version. tpm was observed from x-ratelimit headers on /chat/completions (Mistral sends none on /models). Regenerate with: npm run verify-provider mistral -- --validate --apply",
